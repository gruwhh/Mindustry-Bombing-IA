sensor config sorter1 @config
jump idle notEqual config @copper
write 1 cell1 0
end

idle:
jump periodic_att notEqual config @lead
write 0 cell1 0
end

periodic_att:
jump END notEqual config @metaglass
read attack cell1 0
read attack_power cell1 13
read max_attack_power cell1 17
op mul attack_threshold max_attack_power 0.95
op mul idle_threshold max_attack_power 0.1

jump idle_auto notEqual attack 1
jump END greaterThanEq attack_threshold attack_power
write 1 cell1 0
idle_auto:
jump END lessThanEq idle_threshold attack_power
write 0 cell1 0	

END:
end

print "[white] [#ab53cf]Lead [white] [#ab53cf]: Save units\n\n"
print "[white] Metaglass  : Auto"
printflush message4

print "             [#6ec0ff]USE PAYLOAD\n\n"
print "[#83f57d]Quad [white]and [#83f57d]Oct [white]take "
print "[#c56fe8]Spiroct[white], [#c56fe8]Arkyid [white]and [#c56fe8]Toxopid [white]units in payload and drop them on enemy defences"
printflush message5

print "             [#6ec0ff]FULL AUTO\n[orange]COMMING SOON\n\n"

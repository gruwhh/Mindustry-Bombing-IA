draw rect 54 27 26 26
jump 43 notEqual s7 1
draw col %00ff00
jump 44 always
draw col %ff0000
draw rect 0 0 26 26
jump 48 notEqual s8 1
draw col %00ff00
jump 49 always
draw col %ff0000
draw rect 27 0 26 26
jump 53 notEqual s9 1
draw col %00ff00
jump 54 always
draw col %ff0000
draw rect 54 0 26 26

draw col %ffffff
draw image 13 67 @flare 20 0
draw image 39 67 @horizon 20 0
draw image 67 67 @zenith 20 0
draw image 13 39 @antumbra 20 0
draw image 39 39 @eclipse 20 0
draw image 67 39 @quad 20 0
draw image 13 13 @quasar 20 0
draw image 39 13 @vela 20 0
draw image 67 13 @oct 20 0
drawflush display1

# write message blocks
print "[#6ec0ff]Arc for  [white]|  [green]ON[white]/[red]OFF\n"
print "[#6ec0ff]manual   [white]|\n"
print "[#6ec0ff]control  [white]|"
printflush message1

print "             [#6ec0ff]MODE\n\n"
print "[white] [#ff9b38]Copper [white] [#ff9b38]: Attack\n\n"
print "[white] [#ab53cf]Lead [white] [#ab53cf]: Idle\n\n"
print "[white] Metaglass  : Attack periodically"
printflush message2

print "                [#6ec0ff]TARGET\n\n"
print "[white] [#ff9b38]Copper [white] [#ff9b38]: Cores Only\n\n"
print "[white] [#ab53cf]Lead [white] [#ab53cf]: Turrets Only\n\n"
print "[white] Metaglass  : Clear around cores (30 tile radius)\n\n"
print "[white] [#ee68c1]Thorium [white] [#ee68c1]: Clear around cores (60 tile radius)"

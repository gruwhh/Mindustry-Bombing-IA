draw clear 0 0 0
sensor s1 switch1 @enabled
sensor s2 switch2 @enabled
sensor s3 switch3 @enabled
sensor s4 switch4 @enabled
sensor s5 switch5 @enabled
sensor s6 switch6 @enabled
sensor s7 switch7 @enabled
sensor s8 switch8 @enabled
sensor s9 switch9 @enabled

# draw screen background
jump 13 notEqual s1 1
draw col %00ff00
jump 14 always
draw col %ff0000
draw rect 0 54 26 26
jump 18 notEqual s2 1
draw col %00ff00
jump 19 always
draw col %ff0000
draw rect 27 54 26 26
jump 23 notEqual s3 1
draw col %00ff00
jump 24 always

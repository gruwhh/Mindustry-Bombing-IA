set origin 76
set prev_tot_unit tot_unit
set prev_tot_power tot_power
set prev_diff_u diff_u
set prev_diff_p diff_p
op add prev_diff_u_draw prev_diff_u origin

read tot_unit cell1 10
read tot_power cell1 11

op sub diff_u tot_unit prev_tot_unit
op sub diff_p tot_power prev_tot_power 


draw color 0 0 0 255
draw line i 0 i 176
draw color 0 255 0 255
draw lineRect i 76 -1 tot_unit
draw color 255 0 0 255
draw lineRect i prev_diff_u_draw -1 diff_u


op add i i 1

drawflush display1

jump 0 notEqual i 176
draw color 0 0 0 255
draw line i 0 i 176
set i 0

